:443 {
    tls /certs/fullchain.pem /certs/privkey.pem {
        protocols tls1.2 tls1.3
    }
    request_body {
        max_size 20MB
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    encode zstd gzip
    reverse_proxy api:8000
}
