# Local-only demo; copy to .env. Production must use a fresh DB and unique secrets.
CONTOUR_DEMO=true
CONTOUR_PORT=8000
POSTGRES_PASSWORD=contour-local-only
CONTOUR_ADMIN_PASSWORD=
# Vercel/production: persistent PostgreSQL is required for sessions and decisions.
DATABASE_URL=
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
# Optional LDAPS for pre-provisioned non-admin users. CA must be trusted.
CONTOUR_LDAP_URL=
CONTOUR_LDAP_BIND_TEMPLATE=
CONTOUR_LDAP_CA_FILE=
